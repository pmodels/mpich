# this gives access to the mpich header files (MPI Standard ABI, libmpi_abi)
prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: mpich
Description: High Performance and portable MPI (MPI Standard ABI)
Version: @MPICH_VERSION@
URL: http://www.mcs.anl.gov/research/projects/mpich
Requires:
Libs: @WRAPPER_C_DYNAMIC_LOADING_FLAGS@ @WRAPPER_LDFLAGS@ -L${libdir} -l@MPIABILIBNAME@ @LPMPIABILIBNAME@
Libs.private: @EXTERNAL_LIB_PATHS@ @EXTERNAL_LIBS@
Cflags: -DMPI_ABI @WRAPPER_CPPFLAGS@ @WRAPPER_CFLAGS@ -I${includedir}
