include:
    src/mpl/src/misc

shim:
    mpl

template:
    /* Test the long double <-> binary128 conversion in mpl_float.c for a long
     * double that is binary64 (macOS arm64), whatever the native long double
     * is. Configure would define MPL_LDBL_MANT_DIG; here it is fixed so that the
     * checks always run. mpl_float.c is included, rather than listed in
     * sources:, so that it sees the definition. */
    #define MPL_LDBL_MANT_DIG 53
    #include "mpl.h"
    #include "mpl_float.c"

    /* START UNIT - driver (also used by mpl_float_x87.unit) */
    /* A native long double is given and printed as hex: 16 digits of binary64
     * bits, or for x87 4 digits of sign and exponent followed by 16 digits of
     * significand. binary128 is given and printed as its 32 big-endian hex
     * digits.
     *
     * ./t to128 native    - convert to binary128 and print it
     * ./t from128 hex     - convert to native and print it
     * ./t check n         - for n random values, check that native -> binary128
     *                       -> native gives back the value, and that binary128
     *                       -> native -> binary128 -> native gives the same
     *                       native value both times; print "ok"
     */

    #if MPL_LDBL_MANT_DIG == 53
    #define NATIVE_SIZE 8
    #else
    #define NATIVE_SIZE 10
    #endif

    typedef struct {
        unsigned char b[16];
    } native_t;

    static uint64_t rand_state = 88172645463325252ULL;
    static uint64_t rand64(void)
    {
        rand_state ^= rand_state << 13;
        rand_state ^= rand_state >> 7;
        rand_state ^= rand_state << 17;
        return rand_state;
    }

    static int parse_hex(const char *s, int ndigits, uint64_t * out)
    {
        char buf[17];
        if (ndigits > 16 || (int) strlen(s) < ndigits) {
            return 1;
        }
        memcpy(buf, s, ndigits);
        buf[ndigits] = '\0';
        char *end;
        *out = strtoull(buf, &end, 16);
        return *end != '\0';
    }

    static native_t make_native(uint16_t se, uint64_t m)
    {
        native_t x;
        memset(&x, 0, sizeof(x));
    #if MPL_LDBL_MANT_DIG == 53
        (void) se;
        memcpy(x.b, &m, 8);
    #else
        memcpy(x.b, &m, 8);
        memcpy(x.b + 8, &se, 2);
    #endif
        return x;
    }

    static int parse_native(const char *s, native_t * x)
    {
        uint64_t se = 0, m;
    #if MPL_LDBL_MANT_DIG == 53
        if (strlen(s) != 16 || parse_hex(s, 16, &m)) {
            return 1;
        }
    #else
        if (strlen(s) != 20 || parse_hex(s, 4, &se) || parse_hex(s + 4, 16, &m)) {
            return 1;
        }
    #endif
        *x = make_native((uint16_t) se, m);
        return 0;
    }

    static void print_native(const native_t * x)
    {
        uint64_t m;
        memcpy(&m, x->b, 8);
    #if MPL_LDBL_MANT_DIG == 53
        printf("%016llx\n", (unsigned long long) m);
    #else
        uint16_t se;
        memcpy(&se, x->b + 8, 2);
        printf("%04x%016llx\n", se, (unsigned long long) m);
    #endif
    }

    static int parse_128(const char *s, unsigned char *b)
    {
        if (strlen(s) != 32) {
            return 1;
        }
        for (int i = 0; i < 16; i++) {
            uint64_t v;
            if (parse_hex(s + 2 * i, 2, &v)) {
                return 1;
            }
            b[i] = (unsigned char) v;
        }
        return 0;
    }

    static void print_128(const unsigned char *b)
    {
        for (int i = 0; i < 16; i++) {
            printf("%02x", b[i]);
        }
        printf("\n");
    }

    /* NaNs compare equal if both are NaN with the same sign */
    static int is_nan(const native_t * x)
    {
        uint64_t m;
        memcpy(&m, x->b, 8);
    #if MPL_LDBL_MANT_DIG == 53
        return ((m >> 52) & 0x7ff) == 0x7ff && (m & ((UINT64_C(1) << 52) - 1));
    #else
        uint16_t se;
        memcpy(&se, x->b + 8, 2);
        return (se & 0x7fff) == 0x7fff && (m << 1);
    #endif
    }

    static int same_native(const native_t * a, const native_t * b)
    {
        if (is_nan(a) || is_nan(b)) {
            int sign_a = a->b[NATIVE_SIZE - 1] >> 7, sign_b = b->b[NATIVE_SIZE - 1] >> 7;
            return is_nan(a) && is_nan(b) && sign_a == sign_b;
        }
        return memcmp(a->b, b->b, NATIVE_SIZE) == 0;
    }

    static native_t random_native(void)
    {
        uint64_t m = rand64();
        uint16_t se = (uint16_t) rand64();
    #if MPL_LDBL_MANT_DIG == 64
        /* only valid encodings: the explicit leading bit is set iff normal */
        if (se & 0x7fff) {
            m |= UINT64_C(1) << 63;
        } else {
            m &= ~(UINT64_C(1) << 63);
        }
    #endif
        return make_native(se, m);
    }

    static int check(int n)
    {
        for (int i = 0; i < n; i++) {
            native_t x = random_native(), y, z;
            unsigned char b[16], c[16];

            memset(&y, 0, sizeof(y));
            MPL_ldouble_to_binary128_be(x.b, b);
            MPL_binary128_be_to_ldouble(b, y.b);
            if (!same_native(&x, &y)) {
                printf("roundtrip: ");
                print_native(&x);
                return 1;
            }

            /* a binary128 value with an exponent near the native range */
            uint64_t hi = rand64(), lo = rand64();
            int bias = MPL_LDBL_MANT_DIG == 53 ? 1023 : 16383;
            int e = 16383 + (int) (rand64() % (2 * bias + 300)) - bias - 150;
            if (e < 0) {
                e = 0;
            } else if (e > 0x7fff) {
                e = 0x7fff;
            }
            hi = (hi & (UINT64_C(1) << 63)) | ((uint64_t) e << 48) |
                (hi & ((UINT64_C(1) << 48) - 1));
            for (int k = 0; k < 8; k++) {
                b[k] = (unsigned char) (hi >> (56 - 8 * k));
                b[8 + k] = (unsigned char) (lo >> (56 - 8 * k));
            }
            memset(&y, 0, sizeof(y));
            memset(&z, 0, sizeof(z));
            MPL_binary128_be_to_ldouble(b, y.b);
            MPL_ldouble_to_binary128_be(y.b, c);
            MPL_binary128_be_to_ldouble(c, z.b);
            if (!same_native(&y, &z)) {
                printf("narrowing not idempotent: ");
                print_128(b);
                return 1;
            }
        }
        printf("ok\n");
        return 0;
    }

    int main(int argc, char **argv)
    {
        if (argc != 3) {
            printf("usage: t to128|from128|check arg\n");
            return 1;
        }

        if (strcmp(argv[1], "to128") == 0) {
            native_t x;
            unsigned char b[16];
            if (parse_native(argv[2], &x)) {
                printf("bad native value\n");
                return 1;
            }
            MPL_ldouble_to_binary128_be(x.b, b);
            print_128(b);
        } else if (strcmp(argv[1], "from128") == 0) {
            native_t x;
            unsigned char b[16];
            if (parse_128(argv[2], b)) {
                printf("bad binary128 value\n");
                return 1;
            }
            memset(&x, 0, sizeof(x));
            MPL_binary128_be_to_ldouble(b, x.b);
            print_native(&x);
        } else if (strcmp(argv[1], "check") == 0) {
            return check(atoi(argv[2]));
        } else {
            printf("unknown command %s\n", argv[1]);
            return 1;
        }
        return 0;
    }
    /* END UNIT */

TESTS:

    # widening is exact

    # zero
    cmd: ./t to128 0000000000000000
    expect: 00000000000000000000000000000000
    # negative zero
    cmd: ./t to128 8000000000000000
    expect: 80000000000000000000000000000000
    # 1
    cmd: ./t to128 3ff0000000000000
    expect: 3fff0000000000000000000000000000
    # -2
    cmd: ./t to128 c000000000000000
    expect: c0000000000000000000000000000000
    # 0.1
    cmd: ./t to128 3fb999999999999a
    expect: 3ffb999999999999a000000000000000
    # largest
    cmd: ./t to128 7fefffffffffffff
    expect: 43fefffffffffffff000000000000000
    # smallest normal
    cmd: ./t to128 0010000000000000
    expect: 3c010000000000000000000000000000
    # largest subnormal
    cmd: ./t to128 000fffffffffffff
    expect: 3c00ffffffffffffe000000000000000
    # smallest subnormal
    cmd: ./t to128 0000000000000001
    expect: 3bcd0000000000000000000000000000
    # infinity
    cmd: ./t to128 7ff0000000000000
    expect: 7fff0000000000000000000000000000
    # negative infinity
    cmd: ./t to128 fff0000000000000
    expect: ffff0000000000000000000000000000
    # quiet NaN
    cmd: ./t to128 7ff8000000000000
    expect: 7fff8000000000000000000000000000
    # signaling NaN becomes quiet, keeping its payload
    cmd: ./t to128 fff4000000000001
    expect: ffffc000000000001000000000000000

    # narrowing

    # 1
    cmd: ./t from128 3fff0000000000000000000000000000
    expect: 3ff0000000000000
    # exact 0.1
    cmd: ./t from128 3ffb999999999999a000000000000000
    expect: 3fb999999999999a
    # 0.1 rounds up
    cmd: ./t from128 3ffb9999999999999999999999999999
    expect: 3fb999999999999a
    # tie rounds down to even
    cmd: ./t from128 3fff0000000000000800000000000000
    expect: 3ff0000000000000
    # tie rounds up to even
    cmd: ./t from128 3fff0000000000001800000000000000
    expect: 3ff0000000000002
    # above a tie rounds up
    cmd: ./t from128 3fff0000000000000800000000000001
    expect: 3ff0000000000001
    # below a tie rounds down
    cmd: ./t from128 3fff00000000000007ffffffffffffff
    expect: 3ff0000000000000
    # 1 + 2^-112 rounds to 1
    cmd: ./t from128 3fff0000000000000000000000000001
    expect: 3ff0000000000000
    # rounds up to infinity
    cmd: ./t from128 43feffffffffffffffffffffffffffff
    expect: 7ff0000000000000
    # rounds down to the largest
    cmd: ./t from128 43fefffffffffffff7ffffffffffffff
    expect: 7fefffffffffffff
    # 2^1024 overflows
    cmd: ./t from128 43ff0000000000000000000000000000
    expect: 7ff0000000000000
    # 1.5 * 2^1024 overflows
    cmd: ./t from128 43ff8000000000000000000000000000
    expect: 7ff0000000000000
    # -1.5 * 2^1024 overflows to negative infinity
    cmd: ./t from128 c3ff8000000000000000000000000000
    expect: fff0000000000000
    # -0.5
    cmd: ./t from128 bffe0000000000000000000000000000
    expect: bfe0000000000000
    # smallest normal
    cmd: ./t from128 3c010000000000000000000000000000
    expect: 0010000000000000
    # rounds up to the smallest normal
    cmd: ./t from128 3c00ffffffffffffffffffffffffffff
    expect: 0010000000000000
    # smallest subnormal
    cmd: ./t from128 3bcd0000000000000000000000000000
    expect: 0000000000000001
    # half the smallest subnormal ties to zero
    cmd: ./t from128 3bcc0000000000000000000000000000
    expect: 0000000000000000
    # above half rounds up to the smallest subnormal
    cmd: ./t from128 3bcc0000000000000000000000000001
    expect: 0000000000000001
    # 1.5 subnormal ties to 2
    cmd: ./t from128 3bcd8000000000000000000000000000
    expect: 0000000000000002
    # underflows to zero
    cmd: ./t from128 3bcb0000000000000000000000000000
    expect: 0000000000000000
    # binary128 normal underflows to negative zero
    cmd: ./t from128 80010000000000000000000000000000
    expect: 8000000000000000
    # infinity
    cmd: ./t from128 7fff0000000000000000000000000000
    expect: 7ff0000000000000
    # negative infinity
    cmd: ./t from128 ffff0000000000000000000000000000
    expect: fff0000000000000
    # quiet NaN
    cmd: ./t from128 7fff8000000000000000000000000000
    expect: 7ff8000000000000
    # signaling NaN becomes quiet, keeping its payload
    cmd: ./t from128 7fff4000000000000000000000000001
    expect: 7ffc000000000000

    # roundtrips of random values

    cmd: ./t check 1000000
    expect: ok
